<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">
  <PropertyGroup>
    <AssemblyName>Universal data Editor</AssemblyName>
    <GenerateAssemblyInfo>False</GenerateAssemblyInfo>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>True</UseWindowsForms>
    <TargetFramework>net481</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>
  <PropertyGroup>
    <LangVersion>15.0</LangVersion>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <CheckForOverflowUnderflow>False</CheckForOverflowUnderflow>
  </PropertyGroup>
  <PropertyGroup>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RootNamespace />
  </PropertyGroup>
  <ItemGroup>
    <None Remove="resources\app.ico" />
    <None Remove="SiV9Az9FW" />
    <EmbeddedResource Include="resources\app.ico" LogicalName="resources/app.ico" />
    <EmbeddedResource Include="SiV9Az9FW" LogicalName="SiV9Az9FW" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="System.Core" />
    <Reference Include="LiteDB" />
    <Reference Include="Newtonsoft.Json" />
    <Reference Include="Pfim" />
    <Reference Include="System.Buffers" />
    <Reference Include="Gapotchenko.Eazfuscator.NET.SDK" />
    <Reference Include="Sentry" />
    <Reference Include="System.Xml" />
    <Reference Include="System.Net.Http" />
    <Reference Include="SharpDX.Direct3D9" />
    <Reference Include="SharpDX.Mathematics" />
    <Reference Include="NCalc" />
    <Reference Include="SharpDX" />
    <Reference Include="Microsoft.mshtml" />
    <Reference Include="PhotoSauce.MagicScaler" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="Microsoft.Bcl.HashCode" />
    <Reference Include="System.Web" />
    <Reference Include="System.Runtime.CompilerServices.Unsafe" />
    <Reference Include="System.Security" />
    <Reference Include="YamlDotNet" />
    <Reference Include="ICSharpCode.SharpZipLib" />
    <Reference Include="System.IO.Compression.FileSystem" />
  </ItemGroup>
</Project>