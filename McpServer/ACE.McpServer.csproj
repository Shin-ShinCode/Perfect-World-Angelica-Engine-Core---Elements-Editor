<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    ACE.McpServer - Angelica Core Editor MCP (Model Context Protocol) server.

    Recovered from the ilspycmd decompile of ACE.McpServer.dll (lost source).
    Dependency versions are pinned to exactly what shipped, as recorded in
    ACE.McpServer.deps.json. The runtime/ASP.NET Core assemblies come from the
    shared frameworks (Microsoft.NETCore.App + Microsoft.AspNetCore.App), so they
    are NOT package references - the Sdk.Web + FrameworkReference below provide them.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>ACE.McpServer</RootNamespace>
    <AssemblyName>ACE.McpServer</AssemblyName>
    <OutputType>Exe</OutputType>

    <!-- Consolidate build output into the single repo-root dist/ folder. -->
    <OutputPath>$(MSBuildThisFileDirectory)..\dist\McpServer\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>

    <!-- Original assembly metadata, preserved from the decompile. -->
    <Version>2026.6.1</Version>
    <FileVersion>2026.6.1</FileVersion>
    <InformationalVersion>2026.6.1</InformationalVersion>
    <Company>Angelica Core</Company>
    <Product>Angelica Core Editor</Product>
    <Copyright>Angelica Core (C) 2026</Copyright>
    <Description>Angelica Core Editor (File Editor and protector for the games based on Angelica Engine)</Description>

    <!-- The server bridges to the Windows editor over a named pipe. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <!--
      ASP.NET Core shared framework (WebApplication, MapMcp HTTP transport) is
      provided implicitly by Microsoft.NET.Sdk.Web - no FrameworkReference needed.
    -->

    <!-- Exact NuGet dependencies from ACE.McpServer.deps.json. -->
    <PackageReference Include="ModelContextProtocol" Version="1.3.0" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="1.3.0" />
    <PackageReference Include="NReco.Logging.File" Version="1.3.1" />
    <!--
      Transitively pulled in by ModelContextProtocol.Core (10.5.2 in deps.json),
      referenced explicitly so the version is pinned and visible.
    -->
    <PackageReference Include="Microsoft.Extensions.AI.Abstractions" Version="10.5.2" />
  </ItemGroup>

</Project>
